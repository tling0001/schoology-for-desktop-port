{
  "name": "schoology-desktop-port",
  "version": "2026.06.0-port.224",
  "description": "Schoology desktop port aligned with the supplied Schoology Android 2026.06.0 source",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux deb rpm --publish never",
    "build:updater": "cargo build --release --manifest-path updater-tauri/Cargo.toml && node scripts/stage-updater.mjs",
    "prepare:tauri": "node scripts/prepare-tauri.mjs",
    "tauri:dev": "npm run prepare:tauri && tauri dev",
    "tauri:build": "npm run prepare:tauri && tauri build",
    "tauri": "tauri"
  },
  "devDependencies": {
    "electron": "^39.1.0",
    "electron-builder": "^26.15.3",
    "@tauri-apps/cli": "^2.12.3"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "@tauri-apps/api": "^2.12.4",
    "pdfjs-dist": "^4.10.38"
  },
  "author": {
    "name": "Schoology Desktop Port",
    "email": "schoology-desktop-port@users.noreply.github.com"
  },
  "build": {
    "appId": "com.schoologytauri.app",
    "productName": "Schoology",
    "artifactName": "Schoology-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/jsqr/**/*",
      "package.json",
      "node_modules/pdfjs-dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/ic_launcher_256.ico",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "updater-tauri/dist/SchoologyUpdater.exe",
          "to": "SchoologyUpdater.exe"
        },
        {
          "from": "chrome-link-handler",
          "to": "chrome-link-handler"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Schoology-${version}-Setup-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "assets/ic_launcher.icns",
      "extraResources": [
        {
          "from": "chrome-link-handler",
          "to": "chrome-link-handler"
        }
      ]
    },
    "protocols": [
      {
        "name": "Schoology Link",
        "schemes": [
          "schoology"
        ]
      }
    ],
    "linux": {
      "extraResources": [
        {
          "from": "chrome-link-handler",
          "to": "chrome-link-handler"
        }
      ]
    }
  },
  "productName": "Schoology"
}
