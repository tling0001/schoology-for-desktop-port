{
  "name": "schoology-windows-port",
  "version": "2025.04.0-port.30",
  "description": "Cross-platform Schoology client port based on the supplied Schoology Android 2026.06 source architecture",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis dir --publish never",
    "dist:win": "electron-builder --win nsis dir --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux deb rpm --publish never"
  },
  "devDependencies": {
    "electron": "^39.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  },
  "author": {
    "name": "Schoology Windows Port",
    "email": "schoology-windows-port@users.noreply.github.com"
  },
  "build": {
    "appId": "com.schoology.app",
    "productName": "Schoology",
    "artifactName": "Schoology-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/jsqr/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "assets/ic_launcher_256.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Schoology-${version}-Setup-${arch}.${ext}"
    }
  }
}
