{
  "name": "schoology-desktop-port",
  "version": "2026.10.0-port.123",
  "description": "ClassWire desktop app aligned with the supplied Schoology Android 2026.10.0 source",
  "scripts": {
    "build:updater": "cargo build --release --manifest-path updater-tauri/Cargo.toml && node scripts/stage-updater.mjs",
    "prepare:tauri": "npm run prepare:icons && node scripts/prepare-tauri.mjs",
    "tauri:dev": "npm run prepare:tauri && tauri dev",
    "tauri:build": "npm run prepare:tauri && tauri build",
    "tauri": "tauri",
    "prepare:icons": "node scripts/prepare-icons.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "@tauri-apps/api": "^2.12.4",
    "pdfjs-dist": "^4.10.38"
  },
  "author": {
    "name": "ClassWire Desktop",
    "email": "schoology-desktop-port@users.noreply.github.com"
  }
}
