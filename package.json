{
  "name": "schoology-desktop-port",
  "version": "2026.06.0-port.119",
  "description": "Schoology desktop port aligned with the supplied Schoology Android 2026.06.0 source",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux deb rpm --publish never",
    "build:updater": "electron-builder --config updater/electron-builder.yml --publish never",
    "pre-dist:win": "npm run build:updater"
  },
  "devDependencies": {
    "electron": "^39.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  },
  "author": {
    "name": "Schoology Desktop Port",
    "email": "schoology-desktop-port@users.noreply.github.com"
  },
  "build": {
    "appId": "com.schoology.app",
    "productName": "Schoology",
    "artifactName": "Schoology-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/jsqr/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/ic_launcher_256.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Schoology-${version}-Setup-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "assets/ic_launcher.icns"
    },
    "extraResources": [
      {
        "from": "updater/dist/SchoologyUpdater.exe",
        "to": "SchoologyUpdater.exe"
      }
    ]
  },
  "productName": "Schoology"
}
