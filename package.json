{
  "name": "schoology-windows-port",
  "version": "2025.04.0-port.22",
  "description": "Cross-platform Schoology client port based on the supplied Android APK architecture",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^39.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  },
  "author": "Schoology Windows Port",
  "build": {
    "appId": "com.schoology.app",
    "productName": "Schoology",
    "artifactName": "Schoology-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/jsqr/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/ic_launcher_256.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
