{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Schoology Updater",
  "version": "1.0.0",
  "identifier": "com.schoology.app.updater",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Schoology Update",
        "width": 520,
        "height": 430,
        "minWidth": 520,
        "minHeight": 430,
        "maxWidth": 520,
        "maxHeight": 430,
        "resizable": false,
        "center": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../src-tauri/icons/icon.png",
      "../src-tauri/icons/icon.ico",
      "../src-tauri/icons/icon.icns"
    ]
  }
}
